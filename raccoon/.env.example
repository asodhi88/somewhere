# Copy this file to .env (which is gitignored) and fill in the real values.
# Never commit .env or any real key.

# Unsplash API — used ONLY by scripts/fetch-images.mjs (a one-off build step).
# The app never calls Unsplash at runtime.
#
# Get a key at https://unsplash.com/developers → New Application → "Access Key".
UNSPLASH_ACCESS_KEY=

# Feedback form — used by the /api/feedback serverless function (server-only;
# these are never exposed to the browser). Set the same two vars in the Vercel
# project's Environment Variables for the deployed form to work.
#
# Get an API key at https://resend.com → API Keys.
RESEND_API_KEY=
# Where feedback submissions are delivered.
FEEDBACK_EMAIL=

# Skyscanner Affiliates Link API — optional. Used by src/lib/links.js to tag
# the outbound flight-handoff link on each result card. If unset, the link is
# still built and still works, just without a mediaPartnerId (no affiliate
# credit). Currently unassigned.
VITE_SKYSCANNER_PARTNER_ID=

# "Ask somewhere" natural-language query parsing — used by the /api/ask
# serverless function (server-only; the key never reaches the browser).
# Set the same vars in the Vercel project's Environment Variables.
#
# Anthropic API key: https://console.anthropic.com → API Keys. Set a monthly
# spend cap on the account too — it is the hard backstop behind the per-IP
# limits below.
ANTHROPIC_API_KEY=

# Per-IP rate limiting (~10/min, ~50/day). Serverless invocations don't share
# memory, so the counters live in Upstash Redis: https://upstash.com → create a
# Redis database → REST API → copy both values.
#
# /api/ask FAILS CLOSED without these — it returns 503 rather than run unmetered.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-dev escape hatch: set to "off" to run /api/ask with no rate-limit store.
# Never set this in production.
ASK_RATE_LIMIT=
