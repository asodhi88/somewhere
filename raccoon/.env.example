# Copy this file to .env (which is gitignored) and fill in the real values.
# Never commit .env or any real key.

# Unsplash API — used ONLY by scripts/fetch-images.mjs (a one-off build step).
# The app never calls Unsplash at runtime.
#
# Get a key at https://unsplash.com/developers → New Application → "Access Key".
UNSPLASH_ACCESS_KEY=

# Feedback form — used by the /api/feedback serverless function (server-only;
# these are never exposed to the browser). Set the same two vars in the Vercel
# project's Environment Variables for the deployed form to work.
#
# Get an API key at https://resend.com → API Keys.
RESEND_API_KEY=
# Where feedback submissions are delivered.
FEEDBACK_EMAIL=
