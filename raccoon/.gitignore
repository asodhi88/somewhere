# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment / secrets — never commit (see .env.example)
.env
.env.*.local

# Design handoff bundles — prototype HTML + duplicated assets extracted from
# Claude Design, one live bundle at a time (see CLAUDE.md §12). Working input,
# never repo history.
handoff/

# PMTiles extracts are build output, cut from tiles/cities.geojson and
# uploaded to Blob storage — never source.
*.pmtiles

# Claude Code session state and its scratch worktrees. The worktrees are whole
# checkouts nested inside the repo — never history, and vitest would otherwise
# scan them and run every test twice (see the vitest exclude in package.json).
.claude/
